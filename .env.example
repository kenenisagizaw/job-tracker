APP_NAME=Job Tracker API
POSTGRES_DB=job_tracker_db
POSTGRES_USER=job_tracker
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/job_tracker_db
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
# Or mount a secret file and set SECRET_KEY_FILE instead of SECRET_KEY.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
DEADLINE_REMINDER_DAYS=3
DEADLINE_REMINDER_INTERVAL_SECONDS=3600
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=notifications@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=notifications@example.com
DOCUMENT_STORAGE_PATH=/app/storage
MAX_DOCUMENT_SIZE_BYTES=10485760
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.doc,.docx,.txt
# Required only when migrating existing jobs before any user exists.
MIGRATION_OWNER_EMAIL=owner@example.com
MIGRATION_OWNER_PASSWORD=replace-with-a-secure-password
